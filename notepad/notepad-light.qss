QMainWindow, QDialog {
    background-color: #F4F6FA;
    color: #0F172A;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QMenuBar {
    background-color: #FFFFFF;
    color: #1E293B;
    border-bottom: 1px solid #E2E8F0;
    padding: 3px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

QMenu {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 26px 6px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

QMenu::separator {
    height: 1px;
    background: #E2E8F0;
    margin: 4px 8px;
}

QToolBar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 4px 8px;
    spacing: 3px;
}

QToolBar::separator {
    width: 1px;
    background: #E2E8F0;
    margin: 5px 6px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px;
}

QToolButton:hover {
    background-color: #EFF6FF;
    border-color: #BFDBFE;
}

QToolButton:pressed {
    background-color: #DBEAFE;
}

QToolButton:checked {
    background-color: #DBEAFE;
    border-color: #93C5FD;
}

QToolButton:disabled {
    opacity: 0.35;
}

QFrame#headerFrame {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
}

QLabel#labelDocBadge {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#labelDocBadge[modified="false"] {
    background-color: #DCFCE7;
    color: #15803D;
}

QLabel#labelDocBadge[modified="true"] {
    background-color: #FEF3C7;
    color: #B45309;
}

QLabel#labelDocInfo {
    color: #475569;
    font-size: 12px;
}

QLabel#labelWrapBadge,
QLabel#labelLineNumBadge,
QLabel#labelAutoSaveBadge {
    background-color: #E2E8F0;
    color: #334155;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11px;
}

QPlainTextEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: none;
    selection-background-color: #BFDBFE;
    selection-color: #0F172A;
}

QStatusBar {
    background-color: #F8FAFC;
    color: #475569;
    border-top: 1px solid #E2E8F0;
    padding: 2px 6px;
}

QStatusBar::item {
    border: none;
}

QLabel#statusPill {
    background-color: #E2E8F0;
    color: #334155;
    border-radius: 8px;
    padding: 2px 9px;
    margin: 2px 3px;
    font-size: 11px;
}

QLabel#authorPill {
    background-color: #DBEAFE;
    color: #1D4ED8;
    border-radius: 8px;
    padding: 2px 10px;
    margin: 2px 3px;
    font-size: 11px;
    font-weight: 600;
}

QFrame#heroFrame {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #EFF6FF, stop:1 #F8FAFC);
    border: 1px solid #BFDBFE;
    border-radius: 10px;
}

QFrame#infoCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QLabel#labelSubtitle {
    color: #2563EB;
    font-size: 12px;
}

QLabel#labelDevKey,
QLabel#labelIdKey,
QLabel#labelStackKey {
    color: #64748B;
    font-weight: 600;
}

QLineEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 10px;
}

QLineEdit:focus {
    border: 1px solid #2563EB;
}

QGroupBox {
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 8px;
    color: #334155;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 5px 14px;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton#btnFindNext,
QPushButton#btnOk {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #1D4ED8;
    font-weight: 600;
}

QPushButton#btnFindNext:hover,
QPushButton#btnOk:hover {
    background-color: #1D4ED8;
}

QPushButton#btnFindNext:pressed,
QPushButton#btnOk:pressed {
    background-color: #1E40AF;
}
